// Secrets.xcconfig.example
// Copy this file to Secrets.xcconfig and fill in your actual values.
// Do NOT commit Secrets.xcconfig to git - it contains sensitive API keys.

// Your Supabase project URL (from Project Settings > API)
SUPABASE_URL = https:/$()/your-project-ref.supabase.co

// Your Supabase anon/public key (from Project Settings > API)
SUPABASE_ANON_KEY = your-anon-key-here

// Your Google Gemini API key (from https://aistudio.google.com)
GEMINI_API_KEY = your-gemini-api-key-here
